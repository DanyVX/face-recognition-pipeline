# Copy to .env (gitignored) and adjust. Every variable the app reads is listed here.

# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Log format: text | json (json writes one object per line; no PII, no embeddings).
LOG_FORMAT=text

# Persist raw uploaded images. Images of faces are biometric data: keep this false
# unless you have a specific, consented reason (default retention is none).
STORE_RAW_IMAGES=false

# Where local data (indexes, SQLite DB, cached embeddings) lives. Gitignored.
DATA_DIR=data

# Where downloaded model files live (see scripts/download_models.py, added in M3). Gitignored.
MODEL_DIR=models

# --- Detection ---
# Discard detections scoring below this (0-1).
DET_MIN_CONFIDENCE=0.5
# Discard faces whose shorter box side is below this many pixels.
MIN_FACE_PX=20
# Keep at most this many faces per image.
MAX_FACES=10

# --- ONNX Runtime ---
# Comma-separated execution providers in order of preference. Unavailable ones fall back to CPU
# with a log line.
ONNX_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider
# Intra-op threads (empty = ONNX Runtime default).
ONNX_THREADS=

# --- Embedding ---
# Faces per inference call. Larger inputs are processed in chunks of this size.
EMBED_MAX_BATCH=16

# --- Gallery and matching ---
# Local database file name inside DATA_DIR.
DB_FILENAME=frp.db
# Search backend: flat (exact) | hnsw | ivf (approximate).
INDEX_BACKEND=flat
# How an identity's several embeddings are combined: max | mean.
AGGREGATION=max
# PROVISIONAL operating points (cosine similarity). Choose them from docs/RESULTS.md for your use;
# accept when score >= threshold.
VERIFY_THRESHOLD=0.4
IDENTIFY_THRESHOLD=0.4
# Enrolling a face at or above this similarity to ANOTHER identity triggers DUPLICATE_POLICY.
DUPLICATE_THRESHOLD=0.6
# ignore | warn | reject
DUPLICATE_POLICY=warn
MAX_EMBEDDINGS_PER_IDENTITY=50
# Several faces in one image: largest | reject (enrollment default reject, queries default largest).
ENROLL_FACE_POLICY=reject
QUERY_FACE_POLICY=largest
# Optional JSON file from `make bench` (results/quality_thresholds.json). Empty = lenient defaults.
QUALITY_THRESHOLDS_FILE=

# --- HTTP API ---
API_HOST=127.0.0.1
API_PORT=8000
# Upload limits (bytes / counts / pixels). Image type is decided by magic bytes, not file names.
MAX_UPLOAD_BYTES=10485760
MAX_IMAGES_PER_ENROLL=10
MAX_IMAGE_SIDE=4096
MAX_IMAGE_PIXELS=128000000
# Seconds for the whole request and for receiving the upload body.
REQUEST_TIMEOUT_SECONDS=30
UPLOAD_TIMEOUT_SECONDS=15
# Per-API-key rate limit (token bucket).
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20
# Inference calls running at once (protects small machines).
MAX_CONCURRENT_INFERENCE=2
# Seconds to let in-flight requests finish on shutdown.
SHUTDOWN_GRACE_SECONDS=20
# Allow clients to request the probe embedding with ?include_embedding=true. Embeddings are
# biometric data: keep this false unless you need it.
RETURN_EMBEDDINGS=false
# Require an API key for /metrics.
METRICS_REQUIRE_AUTH=true
# How long idempotent enroll responses are replayed.
IDEMPOTENCY_TTL_SECONDS=86400

# --- Encryption at rest (AES-256-GCM) and audit ---
# Keys as "id:BASE64(32 bytes)", comma separated. Generate one with: frp keys generate-encryption-key
# The first key is used for new data unless ENCRYPTION_ACTIVE_KEY names another; old keys stay
# listed until data is rotated (frp encryption migrate).
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY=
# Alternative: a JSON key file {"active": "k1", "keys": {"k1": "BASE64"}}.
ENCRYPTION_KEY_FILE=
# DEMO ONLY: create ENCRYPTION_KEY_FILE if it does not exist (key stored next to the data).
ALLOW_KEY_GENERATION=false
# DEVELOPMENT ONLY: allow running without encryption. The service refuses otherwise.
ALLOW_UNENCRYPTED=false
# Record who enrolled/queried what (no biometric content) in DATA_DIR/audit.db.
AUDIT_ENABLED=true
